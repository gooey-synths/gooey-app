{
  "type": "vco",
  "label": "VCO",
  "inputs": [
    { "key": "cv", "label": "V/Oct", "connectable": false },
    { "key": "pwm", "label": "PWM", "connectable": false }
  ],
  "outputs": [{ "key": "out", "label": "OUT", "multiple": true }],
  "controls": [
    {
      "type": "select",
      "key": "waveform",
      "label": "Wave",
      "default": "sine",
      "options": [
        { "value": "sine", "label": "Sine" },
        { "value": "square", "label": "Square" },
        { "value": "saw", "label": "Saw" }
      ]
    },
    {
      "type": "range",
      "key": "frequency",
      "label": "Freq",
      "default": 440,
      "min": 20,
      "max": 2000,
      "step": 1,
      "unit": "Hz"
    },
    {
      "type": "range",
      "key": "pw",
      "label": "PW",
      "default": 0.5,
      "min": 0.05,
      "max": 0.95,
      "step": 0.01
    }
  ]
}
