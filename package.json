{
  "name": "gooey-app",
  "version": "0.0.0",
  "main": "electron/main.js",
  "author": "Gooey Synths",
  "description": "The gooey app.",
  "scripts": {
    "start": "ng serve",
    "electron": "cross-env NODE_ENV=development electron electron/main.js",
    "build": "ng build",
    "build:electron": "ng build --base-href=./ && cross-env NODE_ENV=production electron-forge make",
    "lint": "ng lint",
    "test": "ng test --watch=false --code-coverage --browsers=Chromium",
    "test:ci": "ng test --no-watch --no-progress --browsers=ChromeHeadless",
    "test:e2e": "playwright test",
    "start:forge": "electron-forge start"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.15",
    "@angular/compiler": "^20.3.27",
    "@angular/core": "^20.3.15",
    "@angular/forms": "^20.3.15",
    "@angular/platform-browser": "^20.3.15",
    "@angular/platform-browser-dynamic": "^20.3.15",
    "@angular/router": "^20.3.15",
    "@foblex/2d": "^1.2.1",
    "@foblex/drag-toolkit": "^1.1.0",
    "@foblex/flow": "^17.5.0",
    "@foblex/mediator": "^1.1.2",
    "@foblex/platform": "^1.0.4",
    "@foblex/utils": "^1.1.1",
    "@ngrx/effects": "^20.1.0",
    "@ngrx/store": "^20.1.0",
    "@tailwindcss/postcss": "^4.0.17",
    "electron-log": "^5.3.3",
    "electron-updater": "^6.6.2",
    "ngx-electron": "^2.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.12",
    "@angular/cli": "^20.3.12",
    "@angular/compiler-cli": "^20.3.15",
    "@electron-forge/cli": "^7.8.0",
    "@electron-forge/maker-deb": "^7.8.0",
    "@electron-forge/maker-squirrel": "^7.8.0",
    "@electron-forge/maker-zip": "^7.8.0",
    "@playwright/test": "^1.51.1",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "21.0.1",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "eslint": "^9.28.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.33.1"
  }
}
